generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("Portfolio Manager")
  initials      String
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Portfolio structure
// ---------------------------------------------------------------------------

model Region {
  id   String @id @default(cuid())
  name String @unique

  clubs     Club[]
  campaigns Campaign[]
  alerts    Alert[]

  createdAt DateTime @default(now())
}

model Club {
  id            String @id @default(cuid())
  name          String
  catchmentArea String
  regionId      String
  peakCapacity  Int

  region Region @relation(fields: [regionId], references: [id])

  campaigns     Campaign[]
  utilization   ClubUtilization[]
  memberEvents  MemberEvent[]
  alerts        Alert[]

  createdAt DateTime @default(now())

  @@index([regionId])
}

enum MechanicCategory {
  ACQUISITION
  UTILISATION
}

model Mechanic {
  id                String           @id @default(cuid())
  name              String           @unique
  howItWorks         String
  category          MechanicCategory
  businessObjective String

  campaigns Campaign[]

  createdAt DateTime @default(now())
}

enum AudienceType {
  GENERAL
  STUDENT
  CORPORATE
  HYBRID_WORKER
  LAPSED_MEMBER
  ENGAGED_MEMBER
}

enum CampaignStatus {
  RECOMMENDED
  NEEDS_ATTENTION
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
}

enum CampaignObjective {
  MAXIMISE_INCREMENTAL_JOINS
  FILL_OFF_PEAK_CAPACITY
  IMPROVE_MEMBER_LIFETIME_CONTRIBUTION
  REACTIVATE_DORMANT_MEMBERS
  SUPPORT_NEW_OR_REFURBISHED_GYM
  DEFEND_SITE_AGAINST_COMPETITOR
}

model Campaign {
  id           String            @id @default(cuid())
  name         String
  objective    CampaignObjective
  status       CampaignStatus    @default(RECOMMENDED)
  audienceType AudienceType

  mechanicId String
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  startDate DateTime
  endDate   DateTime
  budget    Float

  incentiveValue Float // % discount depth or £ value depending on mechanic
  offPeakOnly    Boolean @default(false)

  // Predictions (shown pre-decision / in Planning + Simulation)
  predictedJoins     Int
  predictedRoi       Float
  predictedRetention Float
  confidence         Float
  aiRationale        String  @db.Text

  // Guardrails used at simulation time
  minRoiGuardrail        Float?
  maxPeakOccupancyGuardrail Float?

  // Execution / actuals (populated once ACTIVE/COMPLETED)
  actualJoins Int?
  actualRoi   Float?
  healthScore Int?

  memberEvents MemberEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clubId])
  @@index([regionId])
}

// ---------------------------------------------------------------------------
// Metrics & time series
// ---------------------------------------------------------------------------

model PortfolioMonthlyMetric {
  id                 String   @id @default(cuid())
  month              DateTime // first of month
  investment         Float
  incrementalRevenue Float
  joins              Int
  roi                Float

  createdAt DateTime @default(now())

  @@unique([month])
}

model ClubUtilization {
  id             String @id @default(cuid())
  clubId         String
  dayOfWeek      Int // 0=Sun .. 6=Sat
  hour           Int // 0-23
  utilisationPct Float

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, dayOfWeek, hour])
  @@index([clubId])
}

enum MemberEventType {
  JOIN
  CHURN
  REACTIVATE
}

model MemberEvent {
  id            String          @id @default(cuid())
  clubId        String
  campaignId    String?
  type          MemberEventType
  date          DateTime
  isIncremental Boolean @default(false)
  revenueImpact Float   @default(0)

  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([clubId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Intelligence
// ---------------------------------------------------------------------------

enum AlertSeverity {
  CRITICAL
  WARNING
  INSIGHT
}

enum AlertStatus {
  OPEN
  RESOLVED
}

model Alert {
  id          String        @id @default(cuid())
  severity    AlertSeverity
  category    String
  code        String // e.g. A-2041
  title       String
  description String        @db.Text
  impactValue Float
  impactLabel String

  clubId   String?
  club     Club?   @relation(fields: [clubId], references: [id])
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  status     AlertStatus @default(OPEN)
  detectedAt DateTime    @default(now())

  @@index([severity])
  @@index([status])
}

enum ExternalSignalType {
  COMPETITOR
  WEATHER
  HOLIDAY
  EVENT
  TREND
}

model ExternalSignal {
  id          String             @id @default(cuid())
  type        ExternalSignalType
  description String             @db.Text
  detectedAt  DateTime           @default(now())
  metadata    Json?
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id      String   @id @default(cuid())
  userId  String
  role    ChatRole
  content String   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum ChangeLogType {
  COMPETITOR_PRICE
  COMPETITOR_OFFER
  COMPETITOR_OPENING
  INTERNAL_CAMPAIGN_EDIT
}

model ChangeLogEntry {
  id         String        @id @default(cuid())
  type       ChangeLogType
  entityRef  String // free text label of what changed, e.g. club or competitor name
  summary    String        @db.Text
  before     Json?
  after      Json?
  detectedAt DateTime      @default(now())
}
