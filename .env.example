# Neon Postgres connection string (pooled, used at runtime and for migrations)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API key, used by the AI Advisor, campaign recommendations, and alert narratives
ANTHROPIC_API_KEY="sk-ant-..."

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local dev only — Vercel sets this automatically in production
NEXTAUTH_URL="http://localhost:3000"

# Shared secret required to call POST /api/admin/seed (re)populates demo data.
# Generate with: openssl rand -hex 24
SEED_SECRET="generate-a-random-secret"
