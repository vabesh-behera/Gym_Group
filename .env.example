# Neon Postgres connection string — use the DIRECT / unpooled URL (no
# "-pooler" in the hostname), not the pooled one. Neon's pooled connection
# (PgBouncer transaction mode) doesn't support the advisory locks Prisma
# Migrate needs, which causes `prisma migrate deploy` to fail intermittently
# with error P1002. A direct connection works for both migrations and the
# app's normal queries at this project's scale.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Anthropic API key, used by the AI Advisor, campaign recommendations, and alert narratives
ANTHROPIC_API_KEY="sk-ant-..."

# Shared secret required to call POST /api/admin/seed (re)populates demo data.
# Generate with: openssl rand -hex 24
SEED_SECRET="generate-a-random-secret"
